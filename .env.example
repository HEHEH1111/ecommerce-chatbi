# I-03 server settings. Loaded at startup; restart after editing. Never commit a filled .env.
# Copy the exact Beijing endpoint from your Alibaba Cloud Model Studio workspace.
CHATBI_MODEL_PROVIDER=aliyun_bailian
CHATBI_MODEL_REGION=cn-beijing
CHATBI_MODEL_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHATBI_MODEL_NAME=qwen-plus
CHATBI_MODEL_API_KEY=
